# ============================================================
# Gym & Fitness Platform — Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# App
NODE_ENV=development
PORT=3001

# Database (PostgreSQL) — matches docker-compose.yml defaults
DATABASE_URL=postgresql://gymuser:gympass@localhost:5432/gym_fitness?schema=public

# JWT
JWT_SECRET=change-me-to-a-random-32-char-secret-key-here
JWT_EXPIRES_IN=15m

# Refresh Tokens
REFRESH_TOKEN_SECRET=change-me-to-another-random-32-char-secret

# CORS
CORS_ORIGIN=http://localhost:3000
