// ============================================================
// Gym & Fitness Platform — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

/// User's role within the platform
enum UserRole {
  MEMBER
  TRAINER
  ADMIN
}

/// Account-level status
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// How the user registered / logs in
enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

/// Biological sex — used for calorie/macro calculations
enum BiologicalSex {
  MALE
  FEMALE
  NOT_SPECIFIED
}

/// Self-reported fitness level — drives plan difficulty defaults
enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Dietary preference — drives nutrition plan strategy
enum DietaryPreference {
  NO_PREFERENCE
  VEGETARIAN
  VEGAN
  KETO
  PALEO
  HALAL
}

/// Primary muscle group targeted by an exercise
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  FULL_BODY
}

/// Equipment required for an exercise
enum EquipmentType {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  BODYWEIGHT
  KETTLEBELL
  RESISTANCE_BAND
  OTHER
}

/// Exercise difficulty rating
enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Biomechanical movement pattern classification
enum MovementPattern {
  PUSH
  PULL
  HINGE
  SQUAT
  LUNGE
  CARRY
  ROTATION
}

/// Lifecycle status of a workout plan
enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// Status of a single gym session
enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Diet strategy for a nutrition plan
enum DietType {
  BULKING
  CUTTING
  MAINTENANCE
  RECOMPOSITION
}

/// Meal plan generation strategy — drives food selection
enum MealPlanType {
  INDIAN_VEGETARIAN
  INDIAN_NON_VEG
  VEGAN
  HOSTEL_BUDGET
  OFFICE_GOING
}

/// Self-reported physical activity level — drives TDEE multiplier
enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}

/// Budget tier for meal planning
enum BudgetPreference {
  LOW
  MEDIUM
  HIGH
}

/// How often a habit should be performed
enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

/// What kind of scalar is being tracked in progress entries
enum ProgressMetricType {
  BODY_WEIGHT
  BODY_FAT_PCT
  RESTING_HEART_RATE
}

/// Tape measurement site on the body
enum MeasurementSite {
  NECK
  CHEST
  LEFT_BICEP
  RIGHT_BICEP
  WAIST
  HIPS
  LEFT_THIGH
  RIGHT_THIGH
  LEFT_CALF
  RIGHT_CALF
}

/// Standardized pose for progress photos
enum PhotoPose {
  FRONT_RELAXED
  BACK_RELAXED
  SIDE_LEFT
  SIDE_RIGHT
  FRONT_FLEXING
  BACK_FLEXING
}

/// What the user is trying to achieve
enum GoalType {
  LOSE_WEIGHT
  GAIN_MUSCLE
  INCREASE_STRENGTH
  IMPROVE_ENDURANCE
  MAINTAIN
  CUSTOM
}

/// Lifecycle of a goal
enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
  EXPIRED
}

/// Onboarding steps the user must complete
enum OnboardingStep {
  PROFILE_CREATED
  GOAL_SELECTED
  FITNESS_LEVEL_SET
  FIRST_PLAN_CREATED
  FIRST_SESSION_LOGGED
}

/// Category of admin action for audit trail
enum AdminActionType {
  CREATE
  UPDATE
  DELETE
  SUSPEND_USER
  RESTORE_USER
}

// ============================================================
// MODELS
// ============================================================

/// Core user identity — kept slim for fast auth lookups
model User {
  id            String        @id @default(uuid()) @db.Uuid
  username      String        @unique @db.VarChar(30)
  email         String        @unique @db.VarChar(255)
  role          UserRole      @default(MEMBER)
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  credentials           AuthCredential[]
  sessions              AuthSession[]
  passwordResetTokens   PasswordResetToken[]
  profile               Profile?
  onboardingCompletions OnboardingCompletion[]
  exercises             Exercise[]            @relation("CreatedExercises")
  workoutPlans          WorkoutPlan[]
  workoutSessions       WorkoutSession[]
  nutritionPlans        NutritionPlan[]
  habitDefinitions      HabitDefinition[]
  progressEntries       ProgressEntry[]
  bodyMeasurements      BodyMeasurement[]
  progressPhotos        ProgressPhoto[]
  goals                 Goal[]
  adminAuditLogs        AdminAuditLog[]

  @@index([accountStatus], name: "idx_users_account_status")
  @@index([role], name: "idx_users_role")
  @@map("users")
}

/// Login credentials — separated from users for multi-provider support
model AuthCredential {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  provider         AuthProvider @default(EMAIL)
  passwordHash     String?      @map("password_hash") @db.VarChar(255)
  emailVerifiedAt  DateTime?    @map("email_verified_at") @db.Timestamptz
  failedLoginCount Int          @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil      DateTime?    @map("locked_until") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], name: "uq_auth_credentials_user_provider")
  @@map("auth_credentials")
}

/// Active refresh tokens / device sessions
model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  refreshToken String    @unique @map("refresh_token") @db.VarChar(512)
  deviceName   String?   @map("device_name") @db.VarChar(100)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_auth_sessions_user")
  @@map("auth_sessions")
}

/// Time-limited token for password reset flows
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
}

/// Extended user data — fitness preferences, body stats
model Profile {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @map("user_id") @db.Uuid
  firstName         String?           @map("first_name") @db.VarChar(50)
  lastName          String?           @map("last_name") @db.VarChar(50)
  dateOfBirth       DateTime?         @map("date_of_birth") @db.Date
  biologicalSex     BiologicalSex     @default(NOT_SPECIFIED) @map("biological_sex")
  heightCm          Decimal?          @map("height_cm") @db.Decimal(5, 1)
  fitnessLevel      FitnessLevel      @default(BEGINNER) @map("fitness_level")
  dietaryPreference DietaryPreference @default(NO_PREFERENCE) @map("dietary_preference")
  timezone          String            @default("UTC") @db.VarChar(50)
  avatarUrl         String?           @map("avatar_url") @db.VarChar(500)
  weightUnit        String            @default("kg") @map("weight_unit") @db.VarChar(10)
  distanceUnit      String            @default("km") @map("distance_unit") @db.VarChar(10)
  theme             String            @default("system") @map("theme") @db.VarChar(20)
  notifPrefs        Json?             @map("notif_prefs")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Tracks which onboarding steps a user has finished
model OnboardingCompletion {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  step        OnboardingStep
  completedAt DateTime       @default(now()) @map("completed_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, step], name: "uq_onboarding_user_step")
  @@map("onboarding_completions")
}

/// Admin-curated exercise catalog
model Exercise {
  id              String             @id @default(uuid()) @db.Uuid
  exerciseName    String             @unique @map("exercise_name") @db.VarChar(100)
  slug            String             @unique @db.VarChar(120)
  primaryMuscle   MuscleGroup        @map("primary_muscle")
  secondaryMuscle MuscleGroup?       @map("secondary_muscle")
  equipment       EquipmentType
  difficulty      ExerciseDifficulty @default(BEGINNER)
  movementPattern MovementPattern?   @map("movement_pattern")
  instructions    String?            @db.Text
  videoUrl        String?            @map("video_url") @db.VarChar(500)
  imageUrl        String?            @map("image_url") @db.VarChar(500)
  isCompound      Boolean            @default(false) @map("is_compound")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?            @map("created_by") @db.Uuid

  // Relations
  creator            User?               @relation("CreatedExercises", fields: [createdBy], references: [id], onDelete: SetNull)
  workoutDayExercises WorkoutDayExercise[]
  workoutSetLogs     WorkoutSetLog[]

  @@index([primaryMuscle], name: "idx_exercises_primary_muscle")
  @@index([equipment], name: "idx_exercises_equipment")
  @@index([difficulty], name: "idx_exercises_difficulty")
  @@index([isActive], name: "idx_exercises_is_active")
  @@map("exercises")
}

/// A named training program owned by a user
model WorkoutPlan {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  planName      String     @map("plan_name") @db.VarChar(100)
  description   String?    @db.Text
  planStatus    PlanStatus @default(DRAFT) @map("plan_status")
  goalId        String?    @map("goal_id") @db.Uuid
  durationWeeks Int?       @map("duration_weeks") @db.SmallInt
  daysPerWeek   Int        @map("days_per_week") @db.SmallInt
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  workoutDays WorkoutDay[]

  @@index([userId, planStatus], name: "idx_workout_plans_user_status")
  @@map("workout_plans")
}

/// A named day within a workout plan (e.g., "Day 1 — Push")
model WorkoutDay {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  dayName   String   @map("day_name") @db.VarChar(60)
  dayOrder  Int      @map("day_order") @db.SmallInt
  focusArea     String?   @map("focus_area") @db.VarChar(60)
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  plan            WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises       WorkoutDayExercise[]
  workoutSessions WorkoutSession[]

  @@unique([planId, dayOrder], name: "uq_workout_days_plan_order")
  @@index([planId], name: "idx_workout_days_plan")
  @@map("workout_days")
}

/// A prescribed exercise within a workout day
model WorkoutDayExercise {
  id            String   @id @default(uuid()) @db.Uuid
  dayId         String   @map("day_id") @db.Uuid
  exerciseId    String   @map("exercise_id") @db.Uuid
  exerciseOrder Int      @map("exercise_order") @db.SmallInt
  targetSets    Int      @map("target_sets") @db.SmallInt
  targetRepsMin Int      @map("target_reps_min") @db.SmallInt
  targetRepsMax Int      @map("target_reps_max") @db.SmallInt
  restSeconds   Int      @default(60) @map("rest_seconds") @db.SmallInt
  notes         String?  @db.VarChar(300)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  day      WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([dayId, exerciseOrder], name: "uq_day_exercises_day_order")
  @@index([dayId], name: "idx_day_exercises_day")
  @@index([exerciseId], name: "idx_day_exercises_exercise")
  @@map("workout_day_exercises")
}

/// A real gym visit — actual workout session
model WorkoutSession {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  dayId         String?       @map("day_id") @db.Uuid
  sessionStatus SessionStatus @default(IN_PROGRESS) @map("session_status")
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz
  completedAt   DateTime?     @map("completed_at") @db.Timestamptz
  notes         String?       @db.Text
  rating        Int?          @db.SmallInt
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     WorkoutDay?      @relation(fields: [dayId], references: [id], onDelete: SetNull)
  setLogs WorkoutSetLog[]

  @@index([userId, startedAt(sort: Desc)], name: "idx_sessions_user_date")
  @@index([dayId], name: "idx_sessions_day")
  @@index([userId, sessionStatus], name: "idx_sessions_user_status")
  @@map("workout_sessions")
}

/// A single performed set during a workout session
model WorkoutSetLog {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  exerciseId    String   @map("exercise_id") @db.Uuid
  setNumber     Int      @map("set_number") @db.SmallInt
  weightKg      Decimal? @map("weight_kg") @db.Decimal(6, 2)
  repsCompleted Int      @map("reps_completed") @db.SmallInt
  rpe           Decimal? @db.Decimal(3, 1)
  isWarmup      Boolean  @default(false) @map("is_warmup")
  isFailure     Boolean  @default(false) @map("is_failure")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, exerciseId, setNumber], name: "uq_set_logs_session_exercise_set")
  @@index([sessionId], name: "idx_set_logs_session")
  @@index([exerciseId, createdAt(sort: Desc)], name: "idx_set_logs_exercise_date")
  @@map("workout_set_logs")
}

/// Daily calorie and macro targets for a user
model NutritionPlan {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  planName         String            @map("plan_name") @db.VarChar(100)
  dietType         DietType          @map("diet_type")
  dailyCalories    Int               @map("daily_calories") @db.SmallInt
  dailyProteinG    Int               @map("daily_protein_g") @db.SmallInt
  dailyCarbsG      Int               @map("daily_carbs_g") @db.SmallInt
  dailyFatG        Int               @map("daily_fat_g") @db.SmallInt
  bmr              Int?              @db.SmallInt
  tdee             Int?              @db.SmallInt
  isActive         Boolean           @default(true) @map("is_active")
  mealPlanType     MealPlanType?     @map("meal_plan_type")
  activityLevel    ActivityLevel?    @map("activity_level")
  goalType         GoalType?         @map("goal_type")
  budgetPreference BudgetPreference? @map("budget_preference")
  heightCm         Decimal?          @map("height_cm") @db.Decimal(5, 1)
  weightKg         Decimal?          @map("weight_kg") @db.Decimal(5, 1)
  ageAtCreation    Int?              @map("age_at_creation") @db.SmallInt
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealTemplates MealTemplate[]

  @@index([userId], name: "idx_nutrition_plans_user")
  @@index([userId, isActive], name: "idx_nutrition_plans_user_active")
  @@map("nutrition_plans")
}

/// A named meal within a nutrition plan
model MealTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  nutritionPlanId String   @map("nutrition_plan_id") @db.Uuid
  mealName        String   @map("meal_name") @db.VarChar(60)
  mealOrder       Int      @map("meal_order") @db.SmallInt
  calories        Int      @db.SmallInt
  proteinG        Int      @map("protein_g") @db.SmallInt
  carbsG          Int      @map("carbs_g") @db.SmallInt
  fatG            Int      @map("fat_g") @db.SmallInt
  notes           String?  @db.VarChar(500)
  foodItems       Json?    @map("food_items")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  nutritionPlan NutritionPlan @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)

  @@unique([nutritionPlanId, mealOrder], name: "uq_meal_templates_plan_order")
  @@index([nutritionPlanId], name: "idx_meal_templates_plan")
  @@map("meal_templates")
}

/// A habit a user wants to track
model HabitDefinition {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  habitName   String         @map("habit_name") @db.VarChar(80)
  frequency   HabitFrequency @default(DAILY)
  targetValue Decimal?       @map("target_value") @db.Decimal(8, 2)
  unitLabel   String?        @map("unit_label") @db.VarChar(30)
  isActive    Boolean        @default(true) @map("is_active")
  colorHex    String?        @map("color_hex") @db.Char(7)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]

  @@unique([userId, habitName], name: "uq_habit_definitions_user_name")
  @@index([userId], name: "idx_habit_definitions_user")
  @@index([userId, isActive], name: "idx_habit_definitions_user_active")
  @@map("habit_definitions")
}

/// A daily log for a habit
model HabitEntry {
  id            String   @id @default(uuid()) @db.Uuid
  habitId       String   @map("habit_id") @db.Uuid
  entryDate     DateTime @map("entry_date") @db.Date
  isCompleted   Boolean  @default(false) @map("is_completed")
  recordedValue Decimal? @map("recorded_value") @db.Decimal(8, 2)
  notes         String?  @db.VarChar(300)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  habit HabitDefinition @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, entryDate], name: "uq_habit_entries_habit_date")
  @@index([entryDate(sort: Desc)], name: "idx_habit_entries_date")
  @@index([habitId], name: "idx_habit_entries_habit")
  @@index([habitId, entryDate], name: "idx_habit_entries_habit_date")
  @@map("habit_entries")
}

/// A timestamped scalar body metric
model ProgressEntry {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  metricType    ProgressMetricType @map("metric_type")
  recordedValue Decimal            @map("recorded_value") @db.Decimal(7, 2)
  recordedAt    DateTime           @map("recorded_at") @db.Date
  notes         String?            @db.VarChar(300)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metricType, recordedAt], name: "uq_progress_entries_user_metric_date")
  @@index([userId, metricType, recordedAt(sort: Desc)], name: "idx_progress_entries_user_metric_date")
  @@map("progress_entries")
}

/// Tape measurements at body sites
model BodyMeasurement {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  site       MeasurementSite
  valueCm    Decimal         @map("value_cm") @db.Decimal(5, 1)
  measuredAt DateTime        @map("measured_at") @db.Date
  notes      String?         @db.VarChar(300)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, site, measuredAt], name: "uq_body_measurements_user_site_date")
  @@index([userId, measuredAt(sort: Desc)], name: "idx_body_measurements_user_date")
  @@index([userId, site], name: "idx_body_measurements_user_site")
  @@map("body_measurements")
}

/// Reference to a stored progress photo
model ProgressPhoto {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  pose        PhotoPose
  storagePath String    @map("storage_path") @db.VarChar(500)
  takenAt     DateTime  @map("taken_at") @db.Date
  notes       String?   @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt(sort: Desc)], name: "idx_progress_photos_user_date")
  @@map("progress_photos")
}

/// A user's fitness/body goal
model Goal {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  goalType     GoalType   @map("goal_type")
  title        String     @db.VarChar(100)
  description  String?    @db.Text
  targetValue  Decimal?   @map("target_value") @db.Decimal(8, 2)
  targetUnit   String?    @map("target_unit") @db.VarChar(20)
  currentValue Decimal?   @map("current_value") @db.Decimal(8, 2)
  deadline     DateTime?  @db.Date
  goalStatus   GoalStatus @default(ACTIVE) @map("goal_status")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones   GoalMilestone[]
  workoutPlans WorkoutPlan[]

  @@index([userId, goalStatus], name: "idx_goals_user_status")
  @@map("goals")
}

/// Intermediate checkpoint within a goal
model GoalMilestone {
  id             String    @id @default(uuid()) @db.Uuid
  goalId         String    @map("goal_id") @db.Uuid
  title          String    @db.VarChar(100)
  targetValue    Decimal?  @map("target_value") @db.Decimal(8, 2)
  milestoneOrder Int       @map("milestone_order") @db.SmallInt
  isAchieved     Boolean   @default(false) @map("is_achieved")
  achievedAt     DateTime? @map("achieved_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, milestoneOrder], name: "uq_milestones_goal_order")
  @@index([goalId], name: "idx_milestones_goal")
  @@map("goal_milestones")
}

/// Immutable audit log of admin actions
model AdminAuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  adminUserId    String          @map("admin_user_id") @db.Uuid
  actionType     AdminActionType @map("action_type")
  targetTable    String          @map("target_table") @db.VarChar(60)
  targetRecordId String          @map("target_record_id") @db.Uuid
  changeSummary  Json?           @map("change_summary")
  ipAddress      String?         @map("ip_address") @db.VarChar(45)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  admin User @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt(sort: Desc)], name: "idx_audit_logs_admin")
  @@index([targetTable, targetRecordId], name: "idx_audit_logs_target")
  @@map("admin_audit_logs")
}

/// Reference food item from the Indian RDA dataset, used for meal planning
model FoodItem {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(200)
  calories     Int      @db.SmallInt
  proteinG     Float    @map("protein_g") @db.Real
  carbsG       Float    @map("carbs_g") @db.Real
  fatG         Float    @map("fat_g") @db.Real
  fibreG       Float?   @map("fibre_g") @db.Real
  isVeg        Boolean  @default(true) @map("is_veg")
  forBreakfast Boolean  @default(false) @map("for_breakfast")
  forLunch     Boolean  @default(false) @map("for_lunch")
  forDinner    Boolean  @default(false) @map("for_dinner")
  cuisine      String   @default("INDIAN") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([isVeg], name: "idx_food_items_is_veg")
  @@index([forBreakfast], name: "idx_food_items_breakfast")
  @@index([forLunch], name: "idx_food_items_lunch")
  @@index([forDinner], name: "idx_food_items_dinner")
  @@map("food_items")
}
